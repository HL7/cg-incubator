  <description value="The strand orientation of a sequenceLocation. Orientation of molecular sequences, indicating directionality for nucleotides (5' to 3' or 3' to 5') or amino acids (N to C terminus)."/>
  <caseSensitive value="true"/>
  <content value="complete"/>
  <valueSet value="http://hl7.org/fhir/uv/cg-incubator/ValueSet/moleculardefinition-strand"/>
  <concept>
    <code value="forward"/>
    <display value="Forward strand"/>
    <definition value="5' to 3' for nucleotides or N-to-C for amino acids; also known as the positive/plus/sense/Watson strand. Single stranded sequences are conventionally represented in the forward direction."/>
  </concept>
  <concept>
    <code value="reverse"/>
    <display value="Reverse strand"/>
    <definition value="3' to 5' orientation; also known as the negative/minus/antisense/Crick strand. Applicable only to double stranded sequences."/>
  </concept>
</CodeSystem>
