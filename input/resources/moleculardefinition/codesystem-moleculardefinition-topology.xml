  <description value="The structural topology of a molecular entity as defined by the MolecularDefinition resource. Includes linear, circular, linear-discontiguous (gapped), and branched forms."/>
  <caseSensitive value="true"/>
  <content value="complete"/>
  <valueSet value="http://hl7.org/fhir/uv/cg-incubator/ValueSet/moleculardefinition-topology"/>
  <concept>
    <code value="linear"/>
    <display value="Linear"/>
    <definition value="Linear, contiguous sequence (e.g., a chromosome segment, allele, or mRNA)."/>
  </concept>
  <concept>
    <code value="linear-discontiguous"/>
    <display value="Linear discontiguous"/>
    <definition value="Linear sequence with gaps; the molecule consists of multiple non-contiguous segments on a linear axis (e.g., a haplotype spanning multiple exons)."/>
  </concept>
  <concept>
    <code value="circular"/>
    <display value="Circular"/>
    <definition value="Circular, contiguous sequence with no free ends (e.g., a plasmid, mitochondrial genome, or circular RNA)."/>
  </concept>
  <concept>
    <code value="branched"/>
    <display value="Branched"/>
    <definition value="Branched molecular structure (e.g., carbohydrate modifications or branched RNA)."/>
  </concept>
