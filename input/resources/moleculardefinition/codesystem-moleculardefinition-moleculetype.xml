    <definition value="DNA sequence (assumed double stranded, written as single stranded by convention)."/>
  </concept>
  <concept>
    <code value="rna"/>
    <display value="RNA sequence"/>
    <definition value="RNA sequence (assumed single stranded, written as single stranded by convention); may use cDNA or RNA encoding for T/U."/>
